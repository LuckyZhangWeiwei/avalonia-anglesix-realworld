<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource PrimaryBackground}">
            <!-- Add Controls for Previewer Here -->
            <StackPanel Spacing="10">
                <TextBlock>some text</TextBlock>
                <TextBlock Classes="sub1">some text sub1</TextBlock>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"></Setter>
    </Style>
    <Style Selector="TextBlock.sub1">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="0 -5 0 0" />
        <Setter Property="Foreground" Value="{DynamicResource AlertButtonBackgroundGradient}" />
    </Style>
    <Style Selector="TextBlock.sub2">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="0 -5 0 0" />
        <Setter Property="Foreground" Value="{DynamicResource AlertButtonBackgroundGradient}" />
    </Style>
</Styles>